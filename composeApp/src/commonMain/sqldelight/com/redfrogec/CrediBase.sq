CREATE TABLE  Usuario(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    Imagen TEXT,
    Email TEXT NOT NULL UNIQUE,
    Nombre TEXT NOT NULL,
    PasswordHash TEXT NOT NULL,
    PreguntaId INTEGER NOT NULL,
    Respuesta TEXT NOT NULL,
    FechaRegistro TEXT NOT NULL,
    FechaModificacion TEXT,
    TokenId INTEGER,
    Token TEXT,
    TokenExpira TEXT
);

CREATE TABLE LLave(
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    LLavePublica TEXT NOT NULL
);

CREATE TABLE Cliente (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    UsuarioId INTEGER NOT NULL,
    Imagen TEXT,
    Identificacion TEXT NOT NULL UNIQUE,
    Nombre TEXT NOT NULL,
    Email TEXT,
    Telefono TEXT,
    Direccion TEXT,
    Bloqueado INTEGER NOT NULL DEFAULT 0,
    FechaCreacion TEXT,
    FOREIGN KEY(UsuarioId) REFERENCES Usuario(Id)
);

CREATE TABLE Prestamo (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    ClienteId INTEGER NOT NULL,
    Valor REAL NOT NULL,
    TipoPagoId INTEGER NOT NULL,
    InteresId INTEGER NOT NULL,
    NumeroCuotas INTEGER NOT NULL,
    Activo INTEGER NOT NULL DEFAULT 1,
    FechaCreacion TEXT NOT NULL,
    FechaEntrega TEXT NOT NULL,
    FOREIGN KEY(ClienteId) REFERENCES Cliente(Id)
);

CREATE TABLE Cobro (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    PrestamoId INTEGER NOT NULL,
    NumeroCuota INTEGER NOT NULL,
    FechaCobro TEXT NOT NULL,
    FechaPagoCliente TEXT,
    ValorCuota REAL NOT NULL,
    ValorCobrado REAL NOT NULL,
    ValorRestante REAL NOT NULL,
    Pagado INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(PrestamoId) REFERENCES Prestamo(Id)
);

--Usuario--
selectAllUser:
SELECT * FROM Usuario;

findUserByEmail:
SELECT * FROM Usuario WHERE Email = ?;

insertUser:
INSERT INTO Usuario(Imagen, Email, Nombre, PasswordHash, PreguntaId, Respuesta, FechaRegistro, FechaModificacion, TokenId, Token, TokenExpira)
VALUES ?;

updateDataUser:
UPDATE Usuario SET
    Imagen = ?, Email = ?, Nombre = ?, PasswordHash = ?, PreguntaId = ?,
    Respuesta = ?, FechaRegistro = ?, FechaModificacion = ?, TokenId = ?,
    Token = ?, TokenExpira = ?
WHERE Id = ?;

deleteUser:
DELETE FROM Usuario WHERE Id = ?;

--lLaves--
selectAllKey:
SELECT *
FROM LLave;

insertKey:
INSERT INTO LLave(LLavePublica)
VALUES ?;

deleteKey:
DELETE FROM LLave;

--Clientes--
selectAllClients:
SELECT * FROM Cliente WHERE UsuarioId = ?;

findClientByName:
SELECT * FROM Cliente WHERE Nombre = ? AND UsuarioId = ?;

insertClient:
INSERT INTO Cliente(Imagen, UsuarioId, Identificacion, Nombre, Email, Telefono, Direccion, Bloqueado, FechaCreacion)
VALUES ?;

updateDataClient:
UPDATE Cliente SET
    Imagen = ?, UsuarioId = ?,Identificacion = ?,Nombre = ?, Email = ?,
    Telefono = ?, Direccion = ?, Bloqueado = ?, FechaCreacion = ?
WHERE Id = ?;

deleteClient:
DELETE FROM Cliente WHERE Id = ?;

--Prestamos--
selectAllLoansById:
SELECT * FROM Prestamo WHERE Id = ?;

selectAllLoansByUserId:
SELECT
    p.Id,
    c.Nombre,
    p.ClienteId,
    p.Valor,
    p.TipoPagoId,
    p.InteresId,
    p.NumeroCuotas,
    p.Activo,
    p.FechaCreacion,
    p.FechaEntrega
FROM
  Prestamo AS p
INNER JOIN
  Cliente AS c ON p.ClienteId = c.Id
INNER JOIN
  Usuario AS u ON c.UsuarioId = u.Id
WHERE u.Id = ?;

insertLoan:
INSERT INTO Prestamo(ClienteId, Valor, TipoPagoId, InteresId, NumeroCuotas, Activo, FechaCreacion, FechaEntrega)
VALUES ?;

updateDataLoan:
UPDATE Prestamo SET
    ClienteId = ?, Valor = ?,TipoPagoId = ?,InteresId = ?, NumeroCuotas = ?,
    Activo = ?, FechaCreacion = ?, FechaCreacion = ?
WHERE Id = ?;

deleteLoan:
DELETE FROM Prestamo WHERE Id = ?;

--Cobros--
selectAllCollectionById:
SELECT * FROM Cobro WHERE Id = ?;

insertCollection:
INSERT INTO Cobro(PrestamoId, NumeroCuota, FechaCobro, FechaPagoCliente, ValorCuota, ValorCobrado, ValorRestante, Pagado)
VALUES ?;

updateDataCollection:
UPDATE Cobro SET
    PrestamoId = ?, NumeroCuota = ?,FechaCobro = ?,FechaPagoCliente = ?, ValorCuota = ?,
    ValorCobrado = ?, ValorRestante = ?, Pagado = ?
WHERE Id = ?;

deleteCollection:
DELETE FROM Cobro WHERE Id = ?;



